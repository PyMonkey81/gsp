# Regla udev para Tarjetas de Control Actuonix LAC (Linear Actuator Control Board)
# Microchip Custom USB Device: VID=0x04D8, PID=0xFC5F
# Permite que la aplicación en Ubuntu acceda a las 6 tarjetas LAC en el Hub USB sin requerir sudo.

SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="fc5f", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb_device", ATTR{idVendor}=="04d8", ATTR{idProduct}=="fc5f", MODE="0666", GROUP="plugdev", TAG+="uaccess"
